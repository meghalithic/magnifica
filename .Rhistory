setwd("~/Desktop")
load(file = "haldane.list.RData") #load the g matrices calculated above
df <- haldane.list[[1]]
form.meta <- haldane.list[[2]]
mean_by_formation <- haldane.list[[3]]
load(file = "glob.Gmat.RData")
p <- ncol(glob.Gmat)  # number of traits
k <- 5  # target rank (dimensions kept)
eig <- eigen(glob.Gmat, symmetric = TRUE) # values sorted descending
lambda <- eig$values # eigenvalues
V      <- eig$vectors # eigenvectors (columns)
# Sanity check: if some of the retained eigenvalues are negative, the rank chosen exceeds the number of real genetic dimensions.
if (any(lambda[1:k] <= 0)) {
warning("At least one of the top-k eigenvalues is <= 0; ",
"we need to use a smaller k.")
}
# Build the rank-5 Eckart-Young approximation
V_k      <- V[, 1:k, drop = FALSE]  # p x k  (all p rows, top k cols)
lambda_k <- lambda[1:k] # top k eigenvalues
G_rank5 <- V_k %*% diag(lambda_k) %*% t(V_k) # p x p, but rank k
isSymmetric(G_rank5)
is.positive.definite(G_rank5)
g.comp_mat = RandomSkewers(Glob_ext) #need at least
###### GLOBAL G NOISE ------
##Controlling for noise
#Extend G
Glob_ext = ExtendMatrix(glob.Gmat, ret.dim = 5)$ExtMat #not 8 because last eigen value (#8) was negative
Glob_ext <- as.matrix(Glob_ext)
#ignore warning from above
isSymmetric(Glob_ext)
Glob_Ext_std_variances = diag(Glob_ext)
Glob_Ext_eig_variances = eigen(Glob_ext)$values
##need to create random cov.m for comparison
cov.m <- RandomMatrix(8, 1, 1, 100)
G_list <- list(Glob_ext, as.matrix(cov.m))
g.comp_mat = RandomSkewers(Glob_ext) #need at least
Glob_list <- list(Glob_ext, as.matrix(cov.m))
glob.g.comp_mat = RandomSkewers(Glob_list) #need at least
Glob_list <- list(Glob_ext, as.matrix(cov.m))
glob.g.comp_mat = RandomSkewers(Glob_list) #need at least
glob.g.corr_mat = glob.g.comp_mat$correlations + t(glob.g.comp_mat$correlations)
diag(glob.g.corr_mat) = 1
paste("Random Skewers similarity matrix")
corrplot.mixed(glob.g.corr_mat, upper = "number", lower = "pie")
##need to create random cov.m for comparison
cov.m5 <- RandomMatrix(8, 1, 1, 100)
Glob_5_list <- list(G_rank5, as.matrix(cov.m5))
glob.g5.comp_mat = RandomSkewers(Glob_5_list) #need at least
glob.g5.corr_mat = glob.g5.comp_mat$correlations + t(glob.g5.comp_mat$correlations)
diag(glob.g5.corr_mat) = 1
paste("Random Skewers similarity matrix")
corrplot.mixed(glob.g5.corr_mat, upper = "number", lower = "pie")
#compare to:
corrplot.mixed(glob.g.corr_mat, upper = "number", lower = "pie")
help(RandomSkewers)
glob.g5.comp_mat = RandomSkewers(Glob_5_list, Glob_ext) #need at least
glob.ext.g5.corr_mat = glob.ext.g5.comp_mat$correlations + t(glob.ext.g5.comp_mat$correlations)
glob.ext.g5.comp_mat = RandomSkewers(Glob_5_list, Glob_ext) #need at least
glob.ext.g5.corr_mat = glob.ext.g5.comp_mat$correlations + t(glob.ext.g5.comp_mat$correlations)

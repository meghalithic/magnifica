#middle age in Ka
tt.df <- form.meta[-4, c(2, 13, 14)]
tt.df$Start_age <- as.numeric(tt.df$Start_age)
tt.df$End_age <- as.numeric(tt.df$End_age)
tt.df$Mid_age <- tt.df$Start_age - ((tt.df$Start_age-tt.df$End_age)/2)
trait.age <- tt.df$Mid_age
trait.age
bottom
#time is in Ka
#age is in Mya, so need to convert to Ka
bottom = as.numeric(form.meta$Start_age)*1000
bottom
top = as.numeric(form.meta$End_age)*1000
form.meta$med.O18 <- c()
form.meta$sd.med.O18 <- c()
form.meta$n.O18 <- c()
for (i in 1:nrow(form.meta)){
temp = oxy.18$d18O[which(oxy.18$Time <= trunc(bottom[i]) & oxy.18$Time >= trunc(top[i]))] #using trunc to get ages that are in between but not greater than
form.meta$med.O18[i] = median(temp)
form.meta$sd.med.O18[i] = sd(temp)
form.meta$n.O18[i] <- length(temp)
}
#convert ot ˚C
form.meta$temp <- 16.5 - (4.3*form.meta$med.O18) + (0.14*(form.meta$med.O18^2))
form.meta
#make factors
form.meta$formationCode <- factor(form.meta$formationCode,
levels = c("NKLS", "NKBS", "Tewkesbury",
"Upper Kai-Iwi", "Tainui",
"SHCSBSB", "modern"))
